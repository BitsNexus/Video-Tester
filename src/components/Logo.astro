---
import { url } from '../lib/url';
import { SITE } from '../lib/site';

interface Props {
  /** Unique gradient id when the logo appears more than once on a page. */
  id?: string;
  class?: string;
}
const { id = 'logo', class: className = '' } = Astro.props;
---

<a href={url('/')} class:list={['inline-flex items-center gap-2 rounded-lg text-white', className]} aria-label={`${SITE.name} home`}>
  <svg class="size-8 shrink-0" viewBox="0 0 48 48" aria-hidden="true">
    <defs>
      <linearGradient id={id} x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#1a9e5d"></stop>
        <stop offset="1" stop-color="#d2f54d"></stop>
      </linearGradient>
    </defs>
    <circle cx="24" cy="24" r="19" fill="none" stroke={`url(#${id})`} stroke-width="4"></circle>
    <path d="M20 16.2v15.6a1.4 1.4 0 0 0 2.15 1.18l11.9-7.8a1.4 1.4 0 0 0 0-2.36l-11.9-7.8A1.4 1.4 0 0 0 20 16.2Z" fill="#d2f54d"></path>
  </svg>
  <span class="text-lg leading-none font-bold tracking-tight">Video<span class="text-lime">Tester</span></span>
</a>
