---
/**
 * The test workspace. Hidden until a file is chosen; src/scripts/app.ts fills it in.
 * DOM order follows the flow (info → preview/playback → results → technical details), which is
 * also the mobile order; on large screens the grid puts results beside the player.
 */
import Icon from './Icon.astro';

const steps = [
  { id: 'select', label: 'File selected' },
  { id: 'load', label: 'Loading video' },
  { id: 'metadata', label: 'Reading metadata' },
  { id: 'data', label: 'Loading video data' },
  { id: 'playback', label: 'Testing playback' },
  { id: 'result', label: 'Result' },
];

const checks = [
  { id: 'file', label: 'File loaded' },
  { id: 'metadata', label: 'Metadata readable' },
  { id: 'stream', label: 'Video stream detected' },
  { id: 'decode', label: 'Browser can decode video' },
  { id: 'playback', label: 'Playback started successfully' },
];

const infoRows = [
  ['name', 'File name'],
  ['size', 'File size'],
  ['type', 'MIME type'],
  ['ext', 'Extension'],
  ['modified', 'Last modified'],
  ['container', 'Container'],
  ['vcodec', 'Video codec'],
  ['acodec', 'Audio codec'],
  ['duration', 'Duration'],
  ['resolution', 'Resolution'],
  ['aspect', 'Aspect ratio'],
];

const playbackRows = [
  ['ready', 'Ready state'],
  ['network', 'Network state'],
  ['time', 'Current time'],
  ['duration', 'Duration'],
  ['paused', 'Paused'],
  ['ended', 'Ended'],
];
---

<section id="workspace" class="relative mx-auto max-w-7xl px-4 pt-10 pb-20 sm:px-6" aria-label="Video test" hidden data-workspace>
  <!-- File bar -->
  <div class="glass flex flex-col gap-4 p-4 text-white sm:flex-row sm:items-center sm:justify-between sm:p-5">
    <div class="flex min-w-0 items-center gap-3">
      <span class="grid size-11 shrink-0 place-items-center rounded-full bg-brand"><Icon name="film" class="size-5" /></span>
      <div class="min-w-0">
        <p class="truncate text-base font-bold" data-bar="name">—</p>
        <p class="mt-0.5 flex flex-wrap items-center gap-x-2 text-xs text-white/70">
          <span data-bar="size"></span><span aria-hidden="true">·</span><span data-bar="type"></span>
        </p>
      </div>
      <span class="status ml-auto shrink-0 sm:ml-1" data-bar="status" data-status="running">● Testing</span>
    </div>
    <div class="flex flex-wrap gap-2">
      <button type="button" class="btn btn-soft" data-action="retest"><Icon name="rotate-ccw" class="size-4" /> Test again</button>
      <button type="button" class="btn btn-soft" data-action="browse"><Icon name="folder-open" class="size-4" /> Choose another</button>
      <button type="button" class="btn border border-white/25 text-white hover:bg-white/10" data-action="clear"><Icon name="x" class="size-4" /> Clear file</button>
    </div>
  </div>

  <div class="mt-5 grid gap-5 lg:grid-cols-12">
    <!-- Video information -->
    <section class="card p-5 sm:p-6 lg:col-span-5 lg:col-start-8 lg:row-start-2" aria-labelledby="info-heading">
      <h2 id="info-heading" class="flex items-center gap-2 text-lg font-bold"><Icon name="file-search" class="size-5 text-brand" /> Video Information</h2>
      <table class="kv mt-3">
        <caption class="sr-only">Information about the selected video file</caption>
        <tbody>
          {
            infoRows.map(([key, label]) => (
              <tr>
                <th scope="row">{label}</th>
                <td data-info={key}>—</td>
              </tr>
            ))
          }
        </tbody>
      </table>
      <p class="mt-3 text-xs text-gray-500">Container and codecs are read from the file header on your device — a hint to explain results, not the test itself.</p>
    </section>

    <!-- Preview + playback test -->
    <section class="card p-5 sm:p-6 lg:col-span-7 lg:row-span-2 lg:row-start-1 lg:self-start" aria-labelledby="playback-heading">
      <h2 id="playback-heading" class="flex items-center gap-2 text-lg font-bold"><Icon name="monitor-play" class="size-5 text-brand" /> Playback Test</h2>

      <div class="relative mt-4 overflow-hidden rounded-xl bg-ink">
        <video class="block aspect-video max-h-[65vh] w-full bg-black object-contain" controls playsinline preload="auto" hidden data-video aria-label="Video preview"></video>
        <div class="grid aspect-video w-full place-items-center p-6 text-center text-white/80" data-video-placeholder>
          <div>
            <span class="mx-auto grid size-12 place-items-center rounded-full bg-white/10"><Icon name="clapperboard" class="size-6 text-lime" /></span>
            <p class="mt-3 text-sm font-medium" data-placeholder-text>Loading preview…</p>
          </div>
        </div>
      </div>

      <div class="mt-5 flex flex-col gap-4 sm:flex-row sm:items-center">
        <button type="button" class="btn btn-primary btn-lg w-full sm:w-auto" data-action="play-test">
          <Icon name="play" class="size-5" />
          <span data-play-label>Start Playback Test</span>
        </button>
        <p class="text-sm text-gray-600" data-play-help>
          The test plays a short, muted stretch of the video automatically. Use this button if your browser blocks it or to test again with sound.
        </p>
      </div>

      <p class="mt-4 rounded-xl bg-gray-50 px-4 py-3 font-mono text-xs break-words text-gray-700 ring-1 ring-gray-200 sm:text-sm" data-trace aria-label="Playback trace">
        Current time: —
      </p>

      <!-- Timeline -->
      <h3 class="mt-6 text-sm font-bold text-gray-900">Test progress</h3>
      <ol class="mt-3 grid gap-2 sm:grid-cols-3 xl:grid-cols-6" data-timeline>
        {
          steps.map((step, i) => (
            <li class="flex items-center gap-3 rounded-xl bg-gray-50 p-3 ring-1 ring-gray-200 xl:flex-col xl:items-start xl:gap-2" data-step={step.id} data-status="pending">
              <span class="grid size-8 shrink-0 place-items-center rounded-full text-sm font-bold ring-2" data-step-marker aria-hidden="true">
                {i + 1}
              </span>
              <span class="min-w-0">
                <span class="block text-sm leading-tight font-bold text-gray-900" data-step-label>
                  {step.label}
                </span>
                <span class="mt-0.5 block text-xs text-gray-500" data-step-state>
                  ○ Not started
                </span>
              </span>
            </li>
          ))
        }
      </ol>

      <!-- Live playback information -->
      <h3 class="mt-6 text-sm font-bold text-gray-900">Playback Information</h3>
      <dl class="mt-3 grid grid-cols-2 gap-2 sm:grid-cols-3">
        {
          playbackRows.map(([key, label]) => (
            <div class="rounded-xl bg-gray-50 px-3 py-2.5 ring-1 ring-gray-200">
              <dt class="text-xs text-gray-500">{label}</dt>
              <dd class="mt-0.5 text-sm font-bold text-gray-900" data-pb={key}>—</dd>
            </div>
          ))
        }
      </dl>
    </section>

    <!-- Results -->
    <section class="card overflow-hidden lg:col-span-5 lg:col-start-8 lg:row-start-1" aria-labelledby="results-heading">
      <div class="p-5 sm:p-6">
        <h2 id="results-heading" class="flex items-center gap-2 text-lg font-bold"><Icon name="list-checks" class="size-5 text-brand" /> Test Results</h2>

        <div class="mt-4 flex items-start gap-4 rounded-2xl p-4 ring-1" data-verdict="testing" role="status" aria-live="polite" aria-atomic="true">
          <span class="grid size-12 shrink-0 place-items-center rounded-full text-2xl leading-none font-bold" data-verdict-icon aria-hidden="true">●</span>
          <div class="min-w-0">
            <p class="text-xl leading-tight font-bold sm:text-2xl" data-verdict-title>Testing…</p>
            <p class="mt-1 text-sm text-gray-700" data-verdict-message>Checking what your browser can do with this file.</p>
          </div>
        </div>
        <ul class="mt-3 list-disc space-y-1.5 pl-5 text-sm text-gray-700" data-verdict-hints hidden></ul>

        <ul class="mt-5 divide-y divide-gray-100" data-checks aria-label="Individual checks">
          {
            checks.map((check) => (
              <li class="flex items-start justify-between gap-3 py-2.5" data-check={check.id}>
                <span class="min-w-0">
                  <span class="block text-sm font-bold text-gray-900">{check.label}</span>
                  <span class="mt-0.5 block text-xs text-gray-500" data-check-detail>
                    Not tested
                  </span>
                </span>
                <span class="status shrink-0" data-status="pending" data-check-status>
                  ○ Not tested
                </span>
              </li>
            ))
          }
        </ul>
      </div>
      <div class="flex flex-wrap items-center gap-2 border-t border-gray-100 bg-gray-50 px-5 py-4 sm:px-6">
        <button type="button" class="btn btn-outline" data-action="copy"><Icon name="copy" class="size-4" /> Copy results</button>
        <button type="button" class="btn btn-outline" data-action="download"><Icon name="download" class="size-4" /> Download report</button>
        <span class="text-sm font-bold text-pass" data-copy-feedback role="status" aria-live="polite"></span>
      </div>
      <p class="flex gap-2 border-t border-gray-100 px-5 py-4 text-xs leading-relaxed text-gray-600 sm:px-6">
        <Icon name="info" class="mt-px size-4 shrink-0 text-gray-400" />
        <span>
          This is a browser-based test. Results apply to <strong class="font-bold text-gray-900" data-browser>this browser</strong> on this device — support depends on the
          browser, operating system, container, video codec and audio codec. A file that fails here may still play in VLC or another browser.
        </span>
      </p>
    </section>
  </div>

  <!-- Technical details -->
  <section class="card mt-5" aria-labelledby="tech-heading">
    <details class="group/tech" data-tech>
      <summary class="flex cursor-pointer list-none items-center justify-between gap-4 rounded-2xl p-5 sm:p-6 [&::-webkit-details-marker]:hidden">
        <h2 id="tech-heading" class="flex items-center gap-2 text-lg font-bold"><Icon name="cpu" class="size-5 text-brand" /> Technical Details</h2>
        <span class="flex items-center gap-1 text-sm font-bold text-link">
          <span class="group-open/tech:hidden">Show</span><span class="hidden group-open/tech:inline">Hide</span>
          <Icon name="chevron-down" class="size-4 transition-transform group-open/tech:rotate-180" />
        </span>
      </summary>
      <div class="grid gap-6 border-t border-gray-100 p-5 sm:p-6 lg:grid-cols-2">
        <div class="min-w-0">
          <h3 class="text-sm font-bold">Element &amp; file properties</h3>
          <table class="kv kv-raw mt-2 font-mono text-xs">
            <caption class="sr-only">Raw technical properties</caption>
            <tbody data-tech-props></tbody>
          </table>
        </div>
        <div class="min-w-0 space-y-6">
          <div>
            <h3 class="text-sm font-bold"><code>canPlayType()</code> answers</h3>
            <p class="mt-1 text-xs text-gray-500">What this browser says about each type. A hint only — “probably” is not proof that a specific file plays.</p>
            <table class="kv kv-raw mt-2 text-xs">
              <caption class="sr-only">canPlayType results for common MIME types</caption>
              <tbody data-tech-canplay></tbody>
            </table>
          </div>
          <div>
            <h3 class="text-sm font-bold">Media event log</h3>
            <ol class="mt-2 max-h-72 overflow-auto rounded-xl bg-gray-50 p-3 font-mono text-xs leading-relaxed text-gray-700 ring-1 ring-gray-200" data-tech-events></ol>
          </div>
          <div>
            <h3 class="text-sm font-bold">User agent</h3>
            <p class="mt-2 rounded-xl bg-gray-50 p-3 font-mono text-xs break-all text-gray-700 ring-1 ring-gray-200" data-tech-ua></p>
          </div>
        </div>
      </div>
    </details>
  </section>
</section>
